{
    "info": {
        "name": "Perpustakaan Digital API",
        "description": "RESTful API untuk Manajemen Perpustakaan Digital - UTS KEPL 2026",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000/api"
        },
        {
            "key": "token",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Admin User\",\n    \"email\": \"admin@perpustakaan.com\",\n    \"password\": \"password123\",\n    \"password_confirmation\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/register",
                            "host": ["{{base_url}}"],
                            "path": ["register"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.collectionVariables.set('token', jsonData.token);",
                                    "}"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Content-Type", "value": "application/json"}
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@perpustakaan.com\",\n    \"password\": \"password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": ["{{base_url}}"],
                            "path": ["login"]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "pm.collectionVariables.set('token', jsonData.token);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {
                            "raw": "{{base_url}}/logout",
                            "host": ["{{base_url}}"],
                            "path": ["logout"]
                        }
                    }
                }
            ]
        },
        {
            "name": "Books",
            "item": [
                {
                    "name": "Get All Books",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {
                            "raw": "{{base_url}}/books",
                            "host": ["{{base_url}}"],
                            "path": ["books"]
                        }
                    }
                },
                {
                    "name": "Get Single Book",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {
                            "raw": "{{base_url}}/books/1",
                            "host": ["{{base_url}}"],
                            "path": ["books", "1"]
                        }
                    }
                },
                {
                    "name": "Create Book",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Content-Type", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Belajar Laravel 11\",\n    \"author\": \"Taylor Otwell\",\n    \"isbn\": \"978-3-16-148410-0\",\n    \"publisher\": \"Penerbit Tech Indonesia\",\n    \"year\": 2024,\n    \"description\": \"Panduan lengkap belajar Laravel framework dari dasar hingga mahir.\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/books",
                            "host": ["{{base_url}}"],
                            "path": ["books"]
                        }
                    }
                },
                {
                    "name": "Update Book",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Content-Type", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Belajar Laravel 11 - Edisi Revisi\",\n    \"year\": 2025\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/books/1",
                            "host": ["{{base_url}}"],
                            "path": ["books", "1"]
                        }
                    }
                },
                {
                    "name": "Delete Book",
                    "request": {
                        "method": "DELETE",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "url": {
                            "raw": "{{base_url}}/books/1",
                            "host": ["{{base_url}}"],
                            "path": ["books", "1"]
                        }
                    }
                },
                {
                    "name": "Create Book - Validation Error (422)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {"key": "Accept", "value": "application/json"},
                            {"key": "Content-Type", "value": "application/json"},
                            {"key": "Authorization", "value": "Bearer {{token}}"}
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/books",
                            "host": ["{{base_url}}"],
                            "path": ["books"]
                        }
                    }
                },
                {
                    "name": "Get Books - Without Token (401)",
                    "request": {
                        "method": "GET",
                        "header": [
                            {"key": "Accept", "value": "application/json"}
                        ],
                        "url": {
                            "raw": "{{base_url}}/books",
                            "host": ["{{base_url}}"],
                            "path": ["books"]
                        }
                    }
                }
            ]
        }
    ]
}
